---
import { content, person, type Lang } from '../i18n';

interface Props {
  lang: Lang;
}
const { lang } = Astro.props;
const t = content[lang];
const en = content.en;

// Terminal stays in English in both languages (it's a shell).
const lines: { kind: 'cmd' | 'out' | 'ok'; text: string }[] = [
  { kind: 'cmd', text: 'whoami' },
  { kind: 'out', text: 'DevOps Engineer & System Administrator · SRE' },
  { kind: 'cmd', text: 'cat stack.txt' },
  { kind: 'out', text: 'AWS · OCI · GCP · Linux (Ubuntu/RHEL) · Kubernetes · Docker · CI/CD' },
  { kind: 'cmd', text: 'systemctl status jana' },
  { kind: 'ok', text: 'jana.service, Infrastructure & DevOps Engineer' },
  { kind: 'out', text: '   Active: active (open to work) · Saudi Arabia' },
  { kind: 'cmd', text: 'cat /etc/jxtech/founder' },
  { kind: 'out', text: 'Founder @ JXTech Studio · jxtechstudio.com' },
  { kind: 'cmd', text: 'uptime' },
  { kind: 'out', text: `${en.experience.length} roles · ${en.projects.length} projects · ${en.certifications.length} certs · load: low` },
];

const altName = lang === 'ar' ? person.fullNameEn : person.nameAr;
const altLang = lang === 'ar' ? 'en' : 'ar';
---

<section id="top" class="hero" data-section={t.ui.sections.top} data-index="00">
  <div class="hero-bg" aria-hidden="true"></div>

  <div class="container hero-inner">
    <div class="hero-meta mono">
      <span><b>[00]</b> {t.ui.portfolio} · {new Date().getFullYear()}</span>
      <span class="hero-meta-right">{t.profile.location}</span>
    </div>

    <div class="hero-grid">
      <div class="hero-copy">
        <a href="#contact" class="status">
          <i aria-hidden="true"></i>
          <span class="status-main">{t.ui.openToWork}</span>
          <span class="status-sub">{t.ui.openToWorkRoles}</span>
        </a>

        <h1 class="hero-name">
          <span class="hero-first">{t.profile.shortFirst}</span>
          <span class="hero-last"><i aria-hidden="true"></i>{t.profile.shortLast}<i aria-hidden="true"></i></span>
          <span class="hero-alt" lang={altLang} dir={altLang === 'ar' ? 'rtl' : 'ltr'}>{altName}</span>
        </h1>
        <p class="hero-role mono">{t.profile.role}</p>
        <p class="hero-intro">{t.profile.intro}</p>
        <div class="hero-ctas">
          <a href="#projects" class="btn btn-primary">
            {t.ui.viewProjects}
            <svg viewBox="0 0 16 16" fill="none" aria-hidden="true"><path d="M8 3v10m0 0 4-4m-4 4-4-4" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round"></path></svg>
          </a>
          <a href={person.cv} class="btn btn-ghost" download>{t.ui.downloadCv}</a>
        </div>
      </div>

      <div class="hero-side">
        <div class="terminal" role="img" aria-label={t.ui.hero.terminalAria} dir="ltr" lang="en">
          <div class="terminal-bar">
            <span class="dots" aria-hidden="true"><i></i><i></i><i></i></span>
            <span class="mono">jana@jxtechstudio: ~</span>
          </div>
          <div class="terminal-body" aria-hidden="true">
            {lines.map((l, i) => (
              <span class={`t-line t-${l.kind}`} style={`--d:${i}`}><span class="t-pre">{l.kind === 'cmd' ? '$ ' : l.kind === 'ok' ? '● ' : ''}</span>{l.text}</span>
            ))}
            <span class="t-line t-cmd" style={`--d:${lines.length}`}><span class="t-pre">$ </span><span class="t-cursor"></span></span>
          </div>
        </div>
        <ul class="hero-tags" aria-label={t.ui.hero.headlineAria}>
          {t.profile.headline.map((h) => <li>{h}</li>)}
        </ul>
      </div>
    </div>
  </div>
</section>

<style>
  .hero {
    position: relative;
    min-height: 100svh;
    padding-top: calc(var(--header-h) + clamp(24px, 6vh, 64px));
    padding-bottom: clamp(48px, 8vh, 96px);
    display: flex;
    align-items: center;
    isolation: isolate;
  }

  .hero-bg {
    position: absolute;
    inset: 0;
    z-index: -1;
    overflow: hidden;
    background:
      radial-gradient(60% 55% at 78% 30%, rgb(38 31 179 / 0.42), transparent 70%),
      radial-gradient(45% 45% at 15% 90%, rgb(22 17 121 / 0.55), transparent 70%),
      radial-gradient(30% 25% at 92% 85%, rgb(191 9 47 / 0.16), transparent 70%);
  }
  .hero-bg::before {
    content: '';
    position: absolute;
    inset: 0;
    background-image:
      linear-gradient(var(--line) 1px, transparent 1px),
      linear-gradient(90deg, var(--line) 1px, transparent 1px);
    background-size: 64px 64px;
    mask-image: radial-gradient(70% 70% at 60% 40%, #000 20%, transparent 75%);
    -webkit-mask-image: radial-gradient(70% 70% at 60% 40%, #000 20%, transparent 75%);
  }

  .hero-inner {
    display: grid;
    gap: clamp(24px, 4vh, 40px);
  }

  .hero-meta {
    display: flex;
    justify-content: space-between;
    color: var(--text-muted);
  }
  .hero-meta b {
    color: var(--accent-bright);
    font-weight: 500;
  }

  /* ----- Open to work banner ----- */
  .status {
    display: inline-flex;
    align-items: center;
    flex-wrap: wrap;
    gap: 6px 12px;
    margin-bottom: clamp(24px, 4vh, 40px);
    padding-block: 12px;
    padding-inline: 16px 20px;
    border-radius: 999px;
    background: linear-gradient(90deg, rgb(61 220 132 / 0.16), rgb(61 220 132 / 0.05));
    box-shadow:
      inset 0 0 0 1px rgb(61 220 132 / 0.5),
      0 10px 40px -12px rgb(61 220 132 / 0.35);
    transition: transform 160ms var(--ease-out);
  }
  .status:active {
    transform: scale(0.98);
  }
  .status i {
    position: relative;
    width: 10px;
    height: 10px;
    border-radius: 50%;
    background: #3ddc84;
  }
  .status i::after {
    content: '';
    position: absolute;
    inset: 0;
    border-radius: inherit;
    background: #3ddc84;
    animation: ping 2s var(--ease-out) infinite;
  }
  @keyframes ping {
    from {
      transform: scale(1);
      opacity: 0.7;
    }
    to {
      transform: scale(3.2);
      opacity: 0;
    }
  }
  @media (prefers-reduced-motion: reduce) {
    .status i::after {
      animation: none;
    }
  }
  .status-main {
    font-weight: 700;
    font-size: clamp(16px, 1.5vw, 18px);
    color: #7cf0b0;
  }
  .status-sub {
    color: var(--text);
    font-size: clamp(14px, 1.3vw, 16px);
  }

  .hero-name {
    margin: 0;
    display: grid;
    justify-items: start;
    line-height: 1;
  }
  .hero-first {
    font-family: var(--font-display);
    font-weight: 900;
    font-variation-settings: 'opsz' 144, 'SOFT' 100;
    font-size: clamp(104px, 17vw, 236px);
    line-height: 0.82;
    letter-spacing: -0.035em;
    color: var(--crimson);
  }
  .hero-last {
    display: flex;
    align-items: center;
    gap: clamp(12px, 2vw, 24px);
    margin-top: clamp(10px, 1.6vw, 20px);
    font-family: var(--font-sans);
    font-weight: 500;
    font-size: clamp(14px, 1.9vw, 24px);
    letter-spacing: 0.42em;
    text-transform: uppercase;
    margin-inline-end: -0.42em; /* trailing letter-spacing keeps the rules symmetric */
  }
  .hero-last i {
    width: clamp(28px, 6vw, 80px);
    height: 2px;
    background: var(--crimson);
  }
  .hero-alt {
    margin-top: 14px;
    font-size: clamp(16px, 1.8vw, 22px);
    font-weight: 500;
    color: var(--text-muted);
  }
  .hero-alt:lang(ar) {
    font-family: var(--font-ar);
  }

  /* Arabic hero: Plex Arabic bold, no tracking, roomier line-height */
  :global([lang='ar']) .hero-first {
    font-weight: 700;
    letter-spacing: 0;
    line-height: 1.05;
    font-size: clamp(96px, 15vw, 210px);
  }
  :global([lang='ar']) .hero-last {
    letter-spacing: 0;
    margin-inline-end: 0;
    font-size: clamp(20px, 2.4vw, 30px);
    font-weight: 700;
  }

  .hero-grid {
    display: grid;
    gap: 48px;
    align-items: end;
  }
  @media (min-width: 1040px) {
    .hero-grid {
      grid-template-columns: minmax(0, 1fr) minmax(0, 0.92fr);
      gap: clamp(40px, 5vw, 80px);
    }
  }
  .hero-side {
    display: grid;
    gap: 20px;
    min-width: 0;
  }

  .hero-role {
    margin: clamp(28px, 4vh, 44px) 0 12px;
    color: var(--accent-bright);
  }
  .hero-intro {
    margin: 0;
    max-width: 30ch;
    font-size: clamp(21px, 2vw, 27px);
    line-height: 1.3;
    letter-spacing: -0.01em;
    text-wrap: balance;
  }
  :global([lang='ar']) .hero-intro {
    letter-spacing: 0;
    line-height: 1.6;
  }
  .hero-tags {
    list-style: none;
    margin: 0;
    padding: 0;
    display: flex;
    flex-wrap: wrap;
    gap: 6px 0;
    font-family: var(--font-mono);
    font-size: 12.5px;
    color: var(--text-muted);
    max-width: 60ch;
  }
  .hero-tags li:not(:last-child)::after {
    content: '/';
    margin: 0 10px;
    color: var(--text-faint);
  }
  .hero-ctas {
    display: flex;
    flex-wrap: wrap;
    gap: 12px;
    margin-top: 32px;
  }

  /* ----- Terminal ----- */
  .terminal {
    border-radius: var(--radius);
    background: rgb(25 26 25 / 0.72);
    backdrop-filter: blur(10px);
    -webkit-backdrop-filter: blur(10px);
    box-shadow:
      0 0 0 1px var(--line-strong),
      0 30px 80px -20px rgb(38 31 179 / 0.45);
    overflow: hidden;
    min-width: 0;
    text-align: left;
  }
  .terminal-bar {
    display: flex;
    align-items: center;
    gap: 14px;
    padding: 12px 16px;
    border-bottom: 1px solid var(--line);
    color: var(--text-faint);
  }
  .terminal-bar .mono {
    letter-spacing: 0.08em;
    text-transform: uppercase;
    font-size: 12px;
  }
  .dots {
    display: flex;
    gap: 6px;
  }
  .dots i {
    width: 10px;
    height: 10px;
    border-radius: 50%;
    background: var(--line-strong);
  }
  .dots i:first-child {
    background: var(--crimson);
  }
  .terminal-body {
    padding: 20px 20px 24px;
    font-family: var(--font-mono);
    font-size: clamp(12px, 1.2vw, 13.5px);
    line-height: 1.85;
    color: var(--text-muted);
  }
  .t-line {
    display: block;
    white-space: pre-wrap;
    overflow-wrap: anywhere;
    animation: line-in 320ms var(--ease-out) both;
    animation-delay: calc(300ms + var(--d) * 120ms);
  }
  @keyframes line-in {
    from {
      opacity: 0;
      transform: translateY(4px);
    }
  }
  .t-cmd {
    color: var(--text);
  }
  .t-cmd .t-pre {
    color: var(--accent-bright);
  }
  .t-ok {
    color: var(--text);
  }
  .t-ok .t-pre {
    color: #3ddc84;
  }
  .t-cursor {
    display: inline-block;
    width: 0.6em;
    height: 1.1em;
    vertical-align: -0.2em;
    background: var(--text);
    animation: blink 1.1s steps(1) infinite;
  }
  @keyframes blink {
    50% {
      opacity: 0;
    }
  }
  @media (prefers-reduced-motion: reduce) {
    .t-line,
    .t-cursor {
      animation: none;
    }
  }

  @media (max-width: 560px) {
    .hero-meta-right {
      display: none;
    }
    .status {
      border-radius: 18px;
    }
  }
</style>
