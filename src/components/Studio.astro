---
import { Image } from 'astro:assets';
import { content, studioUrl, type Lang } from '../i18n';
import logo from '../assets/logos/jxtech.svg';
import art from '../assets/illustrations/jana-illustration-development.svg';

interface Props {
  lang: Lang;
}
const { lang } = Astro.props;
const t = content[lang];
const s = t.studio;
---

<section id="studio" class="section studio" data-section={t.ui.sections.studio} data-index="06">
  <div class="container">
    <article class="card" data-reveal>
      <div class="copy">
        <p class="section-index mono"><b>[06]</b> {s.kicker}</p>
        <div class="name">
          <Image src={logo} alt="" width={72} height={72} class="logo" />
          <h2 class="title" dir="ltr">{s.name}</h2>
        </div>
        <p class="desc">{s.description}</p>
        <a href={studioUrl} target="_blank" rel="noopener" class="btn btn-primary">{s.visit} ↗</a>
      </div>
      <Image src={art} alt="" width={720} class="art" />
    </article>
  </div>
</section>

<style>
  .card {
    display: grid;
    align-items: center;
    gap: 32px;
    padding: clamp(28px, 5vw, 64px);
    border-radius: calc(var(--radius) + 6px);
    background:
      radial-gradient(70% 90% at 100% 0%, rgb(38 31 179 / 0.35), transparent 70%),
      radial-gradient(50% 70% at 0% 100%, rgb(22 17 121 / 0.45), transparent 70%),
      var(--surface);
    box-shadow:
      0 0 0 1px var(--line-strong),
      0 40px 100px -40px rgb(38 31 179 / 0.6);
    overflow: hidden;
  }
  @media (min-width: 960px) {
    .card {
      grid-template-columns: 1.15fr 1fr;
      gap: clamp(32px, 5vw, 72px);
    }
  }

  .copy {
    display: grid;
    gap: 24px;
    justify-items: start;
  }
  .copy .section-index {
    margin: 0;
  }

  .name {
    display: flex;
    align-items: center;
    gap: clamp(14px, 2vw, 22px);
  }
  .name :global(.logo) {
    flex: none;
    width: clamp(56px, 6vw, 72px);
    height: auto;
    border-radius: 16px;
    box-shadow: 0 0 0 1px var(--line-strong);
  }
  .title {
    margin: 0;
    font-family: var(--font-display);
    font-weight: 800;
    font-variation-settings: 'opsz' 144, 'SOFT' 100;
    font-size: clamp(38px, 5.6vw, 76px);
    line-height: 1;
    letter-spacing: -0.025em;
  }

  .desc {
    margin: 0;
    max-width: 40ch;
    font-size: clamp(19px, 1.9vw, 24px);
    line-height: 1.45;
    text-wrap: pretty;
  }
  :global([lang='ar']) .desc {
    line-height: 1.8;
  }

  .card :global(.art) {
    width: 100%;
    max-width: 520px;
    height: auto;
    justify-self: center;
    border-radius: var(--radius);
    box-shadow: 0 0 0 1px var(--line);
  }
  @media (max-width: 959px) {
    .card :global(.art) {
      max-width: 360px;
    }
  }
</style>
