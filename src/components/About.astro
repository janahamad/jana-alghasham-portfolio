---
import { Image } from 'astro:assets';
import SectionHead from './SectionHead.astro';
import { content, type Lang } from '../i18n';
import art from '../assets/illustrations/jana-illustration-infrastructure.svg';

interface Props {
  lang: Lang;
}
const { lang } = Astro.props;
const t = content[lang];
const h = t.ui.heads.about;
---

<section id="about" class="section" data-section={t.ui.sections.about} data-index="01">
  <div class="container">
    <SectionHead index="01" kicker={h.kicker} title={h.title} />

    <div class="about-grid">
      <figure class="about-art" data-reveal>
        <Image src={art} alt={t.ui.about.artAlt} width={880} />
        <figcaption class="mono" set:html={t.ui.about.artCaption} />
      </figure>

      <div class="about-copy">
        {t.profile.summary.map((p, i) => <p data-reveal style={`--i:${i}`}>{p}</p>)}

        <dl class="facts" data-reveal style="--i:2">
          {
            t.facts.map((f) => (
              <div>
                <dt class="mono">{f.label}</dt>
                <dd>{f.value}</dd>
              </div>
            ))
          }
        </dl>
      </div>
    </div>

    <ul class="stats">
      {
        t.stats.map((s, i) => (
          <li data-reveal style={`--i:${i}`}>
            <span class="stat-num">{String(s.value).padStart(2, '0')}</span>
            <span class="stat-label mono">{s.label}</span>
          </li>
        ))
      }
    </ul>
  </div>
</section>

<style>
  .about-grid {
    display: grid;
    gap: 40px;
  }
  @media (min-width: 900px) {
    .about-grid {
      grid-template-columns: minmax(300px, 1fr) 1.15fr;
      gap: clamp(48px, 6vw, 96px);
      align-items: center;
    }
  }

  .about-art {
    margin: 0;
  }
  .about-art :global(img) {
    width: 100%;
    height: auto;
    aspect-ratio: 4 / 3;
    object-fit: cover;
    border-radius: var(--radius);
    box-shadow: 0 0 0 1px var(--line);
  }
  .about-art figcaption {
    margin-top: 12px;
    color: var(--text-faint);
  }
  .about-art figcaption :global(span) {
    color: var(--text-muted);
  }

  .about-copy p {
    margin: 0 0 20px;
    font-size: clamp(18px, 1.7vw, 21px);
    line-height: 1.55;
    text-wrap: pretty;
  }
  :global([lang='ar']) .about-copy p {
    line-height: 1.85;
  }
  .about-copy p + p {
    color: var(--text-muted);
  }

  .facts {
    display: grid;
    grid-template-columns: repeat(2, minmax(0, 1fr));
    margin: 40px 0 0;
    border-top: 1px solid var(--line);
  }
  .facts div {
    padding: 18px 0;
    border-bottom: 1px solid var(--line);
  }
  .facts div:nth-child(odd) {
    padding-inline-end: 16px;
  }
  .facts dt {
    color: var(--text-faint);
    margin-bottom: 6px;
  }
  .facts dd {
    margin: 0;
  }

  .stats {
    list-style: none;
    margin: clamp(64px, 9vw, 120px) 0 0;
    padding: 0;
    display: grid;
    grid-template-columns: repeat(2, minmax(0, 1fr));
    border-top: 1px solid var(--line);
  }
  @media (min-width: 800px) {
    .stats {
      grid-template-columns: repeat(4, minmax(0, 1fr));
    }
  }
  .stats li {
    display: grid;
    gap: 10px;
    padding-block: 28px 8px;
    padding-inline-end: 16px;
  }
  .stat-num {
    font-family: var(--font-display);
    font-weight: 800;
    font-variation-settings: 'opsz' 144, 'SOFT' 100;
    font-size: clamp(56px, 8vw, 104px);
    line-height: 0.9;
    letter-spacing: -0.03em;
    font-variant-numeric: tabular-nums;
  }
  .stats li:first-child .stat-num {
    color: var(--crimson);
  }
  .stat-label {
    color: var(--text-muted);
    max-width: 22ch;
    line-height: 1.5;
  }
</style>
