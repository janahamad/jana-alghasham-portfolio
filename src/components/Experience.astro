---
import { Image } from 'astro:assets';
import SectionHead from './SectionHead.astro';
import { content, type Lang } from '../i18n';
import aljawad from '../assets/logos/aljawad_logo.png';
import nadeer from '../assets/logos/Nadeer_logo.jpg';
import t2 from '../assets/logos/T2_logo.jpg';
import manafa from '../assets/logos/Manafa_logo.jpg';

interface Props {
  lang: Lang;
}
const { lang } = Astro.props;
const t = content[lang];
const head = t.ui.heads.experience;
const logos = { aljawad, nadeer, t2, manafa } as const;
---

<section id="experience" class="section" data-section={t.ui.sections.experience} data-index="04">
  <div class="container">
    <SectionHead index="04" kicker={head.kicker} title={head.title} />

    <ol class="timeline">
      {
        t.experience.map((job) => (
          <li class="job" data-reveal>
            <div class="job-when">
              <span class="mono job-period">{job.period}</span>
              <span class="mono job-loc">{job.location}</span>
            </div>
            <div class="job-main">
              <div class="job-head">
                <Image src={logos[job.logo]} alt="" width={48} height={48} class="job-logo" />
                <div class="job-title">
                  <h3 class="job-role">{job.role}</h3>
                  <p class="job-company">{job.company}</p>
                </div>
              </div>
              <ul class="job-points">
                {job.points.map((p) => (
                  <li>{p}</li>
                ))}
              </ul>
            </div>
          </li>
        ))
      }
    </ol>
  </div>
</section>

<style>
  .timeline {
    list-style: none;
    margin: 0;
    padding: 0;
    border-top: 1px solid var(--line);
  }
  .job {
    position: relative;
    display: grid;
    gap: 16px;
    padding: clamp(28px, 4vw, 44px) 0;
    border-bottom: 1px solid var(--line);
  }
  @media (min-width: 900px) {
    .job {
      grid-template-columns: 260px 1fr;
      gap: 48px;
    }
  }

  .job-when {
    display: flex;
    flex-wrap: wrap;
    gap: 6px 16px;
    align-content: start;
  }
  @media (min-width: 900px) {
    .job-when {
      flex-direction: column;
      padding-top: 6px;
    }
  }
  .job-period {
    color: var(--text);
  }
  .job-loc {
    color: var(--text-faint);
  }

  .job-head {
    display: flex;
    align-items: center;
    gap: 16px;
  }
  :global(.job-logo) {
    flex: none;
    width: 48px;
    height: 48px;
    object-fit: contain;
    border-radius: 10px;
    background: #fff;
    padding: 4px;
  }
  .job-title {
    min-width: 0;
  }
  .job-role {
    margin: 0;
    font-size: clamp(19px, 2vw, 24px);
    font-weight: 600;
    line-height: 1.25;
    letter-spacing: -0.01em;
  }
  :global([lang='ar']) .job-role {
    letter-spacing: 0;
    line-height: 1.5;
  }
  .job-company {
    margin: 2px 0 0;
    color: var(--accent-bright);
  }

  .job-points {
    margin: 20px 0 0;
    padding: 0;
    list-style: none;
    display: grid;
    gap: 10px;
    color: var(--text-muted);
    max-width: 78ch;
  }
  .job-points li {
    position: relative;
    padding-inline-start: 22px;
    text-wrap: pretty;
  }
  .job-points li::before {
    content: '';
    position: absolute;
    inset-inline-start: 2px;
    top: 0.75em;
    width: 8px;
    height: 1.5px;
    background: var(--crimson);
  }
</style>
