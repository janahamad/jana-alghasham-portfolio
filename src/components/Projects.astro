---
import { Image } from 'astro:assets';
import type { ImageMetadata } from 'astro';
import SectionHead from './SectionHead.astro';
import { content, pad, type Lang } from '../i18n';

interface Props {
  lang: Lang;
}
const { lang } = Astro.props;
const t = content[lang];
const ui = t.ui.projects;
const head = t.ui.heads.projects;
const projects = t.projects;

const images = import.meta.glob<{ default: ImageMetadata }>('../assets/projects/*.png', { eager: true });
const img = (name: string) => images[`../assets/projects/${name}.png`].default;
---

<section id="projects" class="section" data-section={t.ui.sections.projects} data-index="03">
  <div class="container">
    <SectionHead index="03" kicker={head.kicker} title={head.title} lead={head.lead} />

    <div class="carousel" data-carousel data-reveal>
      <ul class="track" data-track aria-label={ui.carousel} aria-roledescription="carousel">
        {
          projects.map((p, i) => (
            <li class="slide" data-slide aria-roledescription="slide" aria-label={`${i + 1} ${ui.of} ${projects.length}`}>
              <article class="card">
                <button type="button" class="card-hit" data-open-case={p.slug} aria-haspopup="dialog" aria-controls="case-drawer">
                  <span class="sr-only">{ui.open}: {p.title}</span>
                </button>
                <div class="card-media">
                  <Image
                    src={img(p.image)}
                    alt=""
                    widths={[640, 960, 1400]}
                    sizes="(min-width: 900px) 720px, 92vw"
                    loading={i < 2 ? 'eager' : 'lazy'}
                  />
                </div>
                <div class="card-body">
                  <p class="card-meta mono">
                    <span class="card-num">{pad(i + 1)}</span>
                    <span>{p.category}</span>
                    <span class="card-type">{p.type}</span>
                  </p>
                  <h3 class="card-title">{p.title}</h3>
                  <p class="card-summary">{p.summary}</p>
                  <ul class="card-stack" aria-label={ui.stack}>
                    {p.stack.slice(0, 6).map((s) => <li class="chip">{s}</li>)}
                  </ul>
                  <span class="card-cta mono" aria-hidden="true">{ui.read} <i>{t.ui.arrow}</i></span>
                </div>
              </article>
            </li>
          ))
        }
      </ul>

      <div class="controls">
        <p class="count mono" aria-live="polite">
          <span data-current>01</span>
          <span class="count-sep">/</span>
          <span>{pad(projects.length)}</span>
        </p>
        <div class="bars" role="group" aria-label={ui.carousel}>
          {projects.map((p, i) => (
            <button type="button" class="bar" data-goto={i} aria-label={`${pad(i + 1)}: ${p.title}`}>
              <i />
            </button>
          ))}
        </div>
        <div class="arrows">
          <button type="button" class="arrow" data-prev aria-label={ui.prev}>
            <svg viewBox="0 0 16 16" fill="none" aria-hidden="true"><path d="M10 3 5 8l5 5" stroke="currentColor" stroke-width="1.6" stroke-linecap="round" stroke-linejoin="round" /></svg>
          </button>
          <button type="button" class="arrow" data-next aria-label={ui.next}>
            <svg viewBox="0 0 16 16" fill="none" aria-hidden="true"><path d="m6 3 5 5-5 5" stroke="currentColor" stroke-width="1.6" stroke-linecap="round" stroke-linejoin="round" /></svg>
          </button>
        </div>
      </div>
    </div>
  </div>
</section>

<dialog id="case-drawer" class="drawer" aria-labelledby="case-title" data-drawer>
  <div class="drawer-panel">
    <div class="drawer-top">
      <span class="mono drawer-crumb">{ui.caseStudy}</span>
      <button type="button" class="drawer-close" data-drawer-close aria-label={ui.closeCase}>
        <svg viewBox="0 0 16 16" aria-hidden="true"><path d="M3.5 3.5l9 9m0-9-9 9" stroke="currentColor" stroke-width="1.6" stroke-linecap="round"></path></svg>
      </button>
    </div>

    {
      projects.map((p, i) => (
        <article class="case" data-case={p.slug} hidden>
          <p class="mono case-meta">
            <span class="card-num">{pad(i + 1)}</span> {p.category} · {p.type}
          </p>
          <h2 class="case-title" id={`case-title-${p.slug}`}>{p.title}</h2>
          <p class="case-summary">{p.summary}</p>

          <Image src={img(p.image)} alt={`${ui.screenshotOf} ${p.title}`} widths={[640, 1000, 1400]} sizes="(min-width: 760px) 720px, 100vw" class="case-img" loading="lazy" />

          <h3 class="mono case-h">{ui.problem}</h3>
          <p>{p.problem}</p>

          <h3 class="mono case-h">{ui.architecture}</h3>
          <ol class="flow" aria-label={ui.architecture}>
            {p.flow.map((f) => <li>{f}</li>)}
          </ol>

          <h3 class="mono case-h">{ui.built}</h3>
          <ul class="case-list">{p.built.map((b) => <li>{b}</li>)}</ul>

          <h3 class="mono case-h">{ui.outcome}</h3>
          <ul class="case-list is-outcome">{p.outcomes.map((o) => <li>{o}</li>)}</ul>

          <h3 class="mono case-h">{ui.stack}</h3>
          <ul class="card-stack">{p.stack.map((s) => <li class="chip">{s}</li>)}</ul>

          {p.links && (
            <div class="case-links">
              {p.links.map((l) => (
                <a class="btn btn-ghost" href={l.href} target="_blank" rel="noopener">
                  {l.label} ↗
                </a>
              ))}
            </div>
          )}
        </article>
      ))
    }
  </div>
</dialog>

<script>
  // ----- Carousel -----
  const carousel = document.querySelector<HTMLElement>('[data-carousel]')!;
  const track = carousel.querySelector<HTMLElement>('[data-track]')!;
  const slides = [...carousel.querySelectorAll<HTMLElement>('[data-slide]')];
  const bars = [...carousel.querySelectorAll<HTMLButtonElement>('[data-goto]')];
  const prevBtn = carousel.querySelector<HTMLButtonElement>('[data-prev]')!;
  const nextBtn = carousel.querySelector<HTMLButtonElement>('[data-next]')!;
  const currentEl = carousel.querySelector('[data-current]')!;
  const reduceMotion = window.matchMedia('(prefers-reduced-motion: reduce)');
  let current = 0;

  function setCurrent(i: number) {
    current = i;
    currentEl.textContent = String(i + 1).padStart(2, '0');
    bars.forEach((b, j) => b.setAttribute('aria-current', String(j === i)));
    prevBtn.disabled = i === 0;
    nextBtn.disabled = i === slides.length - 1;
    // Off-screen slides are inert so Tab only reaches the visible project.
    slides.forEach((s, j) => (s.inert = j !== i));
  }

  function goTo(i: number) {
    const target = Math.max(0, Math.min(slides.length - 1, i));
    // Scroll the track itself (not scrollIntoView) so the page never jumps.
    // offsetLeft is relative to the track in both LTR and RTL layouts.
    const left = slides[target].offsetLeft - slides[0].offsetLeft;
    track.scrollTo({ left, behavior: reduceMotion.matches ? 'auto' : 'smooth' });
    setCurrent(target);
  }

  prevBtn.addEventListener('click', () => goTo(current - 1));
  nextBtn.addEventListener('click', () => goTo(current + 1));
  bars.forEach((b) => b.addEventListener('click', () => goTo(Number(b.dataset.goto))));

  // Keep state in sync with swipes / trackpad scrolling.
  const slideIO = new IntersectionObserver(
    (entries) => {
      for (const e of entries) if (e.isIntersecting) setCurrent(slides.indexOf(e.target as HTMLElement));
    },
    { root: track, threshold: 0.6 },
  );
  slides.forEach((s) => slideIO.observe(s));

  // Arrow keys while focus is inside the carousel; direction follows reading order.
  const rtl = document.documentElement.dir === 'rtl';
  carousel.addEventListener('keydown', (e) => {
    if (e.key !== 'ArrowLeft' && e.key !== 'ArrowRight') return;
    e.preventDefault();
    const forward = (e.key === 'ArrowRight') !== rtl;
    goTo(current + (forward ? 1 : -1));
  });

  setCurrent(0);

  const drawer = document.querySelector<HTMLDialogElement>('[data-drawer]')!;
  const panel = drawer.querySelector<HTMLElement>('.drawer-panel')!;
  const cases = [...drawer.querySelectorAll<HTMLElement>('[data-case]')];
  let lastTrigger: HTMLElement | null = null;
  let timer: number | undefined;

  function open(slug: string, trigger: HTMLElement) {
    lastTrigger = trigger;
    window.clearTimeout(timer);
    cases.forEach((c) => (c.hidden = c.dataset.case !== slug));
    drawer.setAttribute('aria-labelledby', `case-title-${slug}`);
    panel.scrollTop = 0;
    drawer.showModal();
    document.documentElement.classList.add('menu-open');
    requestAnimationFrame(() => requestAnimationFrame(() => (drawer.dataset.state = 'open')));
  }

  function close() {
    if (!drawer.open || drawer.dataset.state === 'closing') return;
    drawer.dataset.state = 'closing';
    const done = () => {
      window.clearTimeout(timer);
      panel.removeEventListener('transitionend', onEnd);
      delete drawer.dataset.state;
      drawer.close();
      document.documentElement.classList.remove('menu-open');
      lastTrigger?.focus({ preventScroll: true });
    };
    const onEnd = (e: TransitionEvent) => e.target === panel && e.propertyName === 'transform' && done();
    panel.addEventListener('transitionend', onEnd);
    timer = window.setTimeout(done, 360);
  }

  document.querySelectorAll<HTMLButtonElement>('[data-open-case]').forEach((btn) =>
    btn.addEventListener('click', () => open(btn.dataset.openCase!, btn)),
  );
  drawer.querySelector('[data-drawer-close]')!.addEventListener('click', close);
  drawer.addEventListener('cancel', (e) => {
    e.preventDefault();
    close();
  });
  // Click on the backdrop area (outside the panel) closes.
  drawer.addEventListener('click', (e) => {
    if (e.target === drawer) close();
  });
</script>

<style>
  /* ----- Carousel ----- */
  .carousel {
    display: grid;
    gap: 20px;
  }
  .track {
    list-style: none;
    margin: 0;
    padding: 0;
    display: grid;
    grid-auto-flow: column;
    grid-auto-columns: 100%;
    gap: 24px;
    overflow-x: auto;
    overscroll-behavior-x: contain;
    scroll-snap-type: x mandatory;
    scrollbar-width: none;
    border-radius: var(--radius);
  }
  .track::-webkit-scrollbar {
    display: none;
  }
  .slide {
    display: grid;
    scroll-snap-align: start;
    scroll-snap-stop: always;
  }

  .card {
    position: relative;
    display: grid;
    grid-template-rows: auto 1fr;
    border-radius: var(--radius);
    background: var(--surface);
    box-shadow: inset 0 0 0 1px var(--line);
    overflow: hidden;
  }
  @media (min-width: 900px) {
    .card {
      grid-template-columns: 1.35fr 1fr;
      grid-template-rows: none;
      min-height: 480px;
    }
  }

  /* The whole card is one big button (stretched hit area). */
  .card-hit {
    position: absolute;
    inset: 0;
    z-index: 2;
    border-radius: inherit;
  }
  .card-hit:focus-visible {
    outline-offset: -2px;
  }

  .card-media {
    aspect-ratio: 16 / 10;
    overflow: hidden;
    background: var(--surface-2);
  }
  @media (min-width: 900px) {
    .card-media {
      aspect-ratio: auto;
      height: 100%;
    }
  }
  .card-media img {
    width: 100%;
    height: 100%;
    object-fit: cover;
    object-position: top center;
    transition: transform 600ms var(--ease-out);
  }

  .card-body {
    display: flex;
    flex-direction: column;
    gap: 14px;
    justify-content: center;
    padding: clamp(22px, 3vw, 48px);
  }
  .card-meta {
    margin: 0;
    display: flex;
    flex-wrap: wrap;
    gap: 6px 14px;
    color: var(--text-muted);
  }
  .card-num {
    color: var(--accent-bright);
  }
  .card-type {
    margin-inline-start: auto;
    color: var(--text-faint);
  }
  .card-title {
    margin: 0;
    font-size: clamp(24px, 2.8vw, 40px);
    font-weight: 600;
    line-height: 1.12;
    letter-spacing: -0.02em;
    text-wrap: balance;
  }
  .card-summary {
    margin: 0;
    color: var(--text-muted);
    text-wrap: pretty;
  }
  .card-stack {
    list-style: none;
    margin: 6px 0 0;
    padding: 0;
    display: flex;
    flex-wrap: wrap;
    gap: 6px;
  }
  .card-cta {
    margin-top: 8px;
    color: var(--text);
  }
  .card-cta i {
    display: inline-block;
    font-style: normal;
    color: var(--accent-bright);
    transition: transform 250ms var(--ease-out);
  }
  @media (hover: hover) and (pointer: fine) {
    .card:hover .card-media img {
      transform: scale(1.03);
    }
    .card:hover .card-cta i {
      transform: translateX(calc(4px * var(--dir)));
    }
  }

  /* ----- Controls ----- */
  .controls {
    display: grid;
    grid-template-columns: auto 1fr auto;
    align-items: center;
    gap: clamp(16px, 3vw, 32px);
  }
  .count {
    margin: 0;
    display: flex;
    gap: 8px;
    color: var(--text-faint);
    font-variant-numeric: tabular-nums;
  }
  .count [data-current] {
    color: var(--text);
  }

  .bars {
    display: flex;
    gap: 6px;
  }
  .bar {
    flex: 1;
    height: 24px; /* generous hit area around a thin bar */
    display: grid;
    align-items: center;
  }
  .bar i {
    height: 3px;
    border-radius: 2px;
    background: var(--line-strong);
    transition: background-color 250ms ease;
  }
  .bar[aria-current='true'] i {
    background: var(--crimson);
  }
  @media (hover: hover) and (pointer: fine) {
    .bar:hover i {
      background: var(--text-muted);
    }
    .bar[aria-current='true']:hover i {
      background: var(--crimson);
    }
  }

  .arrows {
    display: flex;
    gap: 10px;
  }
  .arrow {
    display: grid;
    place-items: center;
    width: 52px;
    height: 52px;
    border-radius: 50%;
    border: 1px solid var(--line-strong);
    color: var(--text);
    transition:
      transform 160ms var(--ease-out),
      background-color 200ms ease,
      border-color 200ms ease,
      opacity 200ms ease;
  }
  .arrow svg {
    width: 18px;
    height: 18px;
    transform: scaleX(var(--dir));
  }
  .arrow:active:not(:disabled) {
    transform: scale(0.94);
  }
  .arrow[data-next] {
    background: var(--crimson);
    border-color: var(--crimson);
    color: #fff;
  }
  .arrow:disabled {
    opacity: 0.35;
    cursor: default;
  }
  @media (hover: hover) and (pointer: fine) {
    .arrow:not(:disabled):hover {
      border-color: var(--text-muted);
    }
    .arrow[data-next]:not(:disabled):hover {
      background: #d40c36;
      border-color: #d40c36;
    }
  }
  @media (max-width: 560px) {
    .controls {
      grid-template-columns: auto auto;
      justify-content: space-between;
    }
    .bars {
      grid-column: 1 / -1;
      grid-row: 2;
    }
  }

  /* ----- Drawer ----- */
  .drawer {
    position: fixed;
    inset: 0;
    width: 100%;
    max-width: none;
    height: 100dvh;
    max-height: none;
    margin: 0;
    padding: 0;
    border: 0;
    background: rgb(3 3 3 / 0);
    color: var(--text);
    transition: background-color 300ms ease;
  }
  .drawer::backdrop {
    background: transparent;
  }
  .drawer[data-state='open'] {
    background: rgb(3 3 3 / 0.6);
    backdrop-filter: blur(4px);
    -webkit-backdrop-filter: blur(4px);
  }

  .drawer-panel {
    position: absolute;
    inset-block: 0;
    inset-inline-end: 0;
    width: min(760px, 100%);
    overflow-y: auto;
    overscroll-behavior: contain;
    background: var(--surface-2);
    box-shadow: 0 0 0 1px var(--line-strong);
    transform: translateX(calc(100% * var(--dir)));
    transition: transform 260ms var(--ease-in-out);
  }
  .drawer[data-state='open'] .drawer-panel {
    transform: none;
    transition: transform 520ms var(--ease-drawer);
  }
  @media (max-width: 760px) {
    .drawer-panel {
      inset: auto 0 0 0;
      inset-inline: 0;
      width: 100%;
      max-height: calc(100dvh - 24px);
      border-radius: 18px 18px 0 0;
      box-shadow: 0 -1px 0 var(--line-strong);
      transform: translateY(100%);
    }
  }
  @media (prefers-reduced-motion: reduce) {
    .drawer-panel,
    .drawer[data-state='open'] .drawer-panel {
      transform: none;
      opacity: 0;
      transition: opacity 200ms ease;
    }
    .drawer[data-state='open'] .drawer-panel {
      opacity: 1;
    }
  }

  .drawer-top {
    position: sticky;
    top: 0;
    z-index: 1;
    display: flex;
    align-items: center;
    justify-content: space-between;
    padding: 14px clamp(20px, 4vw, 40px);
    background: rgb(18 19 18 / 0.86);
    backdrop-filter: blur(10px);
    -webkit-backdrop-filter: blur(10px);
    border-bottom: 1px solid var(--line);
  }
  .drawer-crumb {
    color: var(--text-faint);
  }
  .drawer-close {
    display: grid;
    place-items: center;
    width: 40px;
    height: 40px;
    border-radius: 50%;
    border: 1px solid var(--line-strong);
    transition:
      transform 160ms var(--ease-out),
      border-color 200ms ease;
  }
  .drawer-close:active {
    transform: scale(0.94);
  }
  .drawer-close svg {
    width: 16px;
    height: 16px;
  }

  .case {
    padding: clamp(24px, 4vw, 40px) clamp(20px, 4vw, 40px) 56px;
  }
  .case-meta {
    margin: 0 0 12px;
    color: var(--text-muted);
  }
  :global([lang='ar']) .case-title,
  :global([lang='ar']) .card-title {
    letter-spacing: 0;
    line-height: 1.35;
  }
  .case-title {
    margin: 0;
    font-family: var(--font-display);
    font-weight: 800;
    font-variation-settings: 'opsz' 144, 'SOFT' 100;
    font-size: clamp(32px, 5vw, 48px);
    line-height: 1.02;
    letter-spacing: -0.02em;
    text-wrap: balance;
  }
  .case-summary {
    margin: 16px 0 28px;
    font-size: 19px;
    color: var(--text-muted);
  }
  :global(.case-img) {
    width: 100%;
    height: auto;
    border-radius: 10px;
    box-shadow: 0 0 0 1px var(--line);
  }
  .case-h {
    margin: 36px 0 12px;
    color: var(--accent-bright);
    font-weight: 500;
  }
  .case p {
    text-wrap: pretty;
  }
  .case > p:not(.case-meta):not(.case-summary) {
    margin: 0;
    color: var(--text-muted);
  }

  .flow {
    list-style: none;
    margin: 0;
    padding: 0;
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    gap: 8px;
    counter-reset: step;
  }
  .flow li {
    counter-increment: step;
    display: inline-flex;
    align-items: center;
    gap: 8px;
    padding: 8px 12px;
    border-radius: 8px;
    background: var(--surface);
    box-shadow: 0 0 0 1px var(--line-strong);
    font-family: var(--font-mono);
    font-size: 12.5px;
  }
  .flow li::before {
    content: counter(step, decimal-leading-zero);
    color: var(--text-faint);
  }
  .flow li:not(:last-child)::after {
    content: '→';
    margin-inline: 8px -20px;
    color: var(--accent-bright);
  }
  :global([dir='rtl']) .flow li:not(:last-child)::after {
    content: '←';
  }
  .flow li:not(:last-child) {
    margin-inline-end: 20px;
  }

  .case-list {
    margin: 0;
    padding: 0;
    list-style: none;
    display: grid;
    gap: 10px;
    color: var(--text-muted);
  }
  .case-list li {
    position: relative;
    padding-inline-start: 22px;
  }
  .case-list li::before {
    content: '';
    position: absolute;
    inset-inline-start: 2px;
    top: 0.72em;
    width: 8px;
    height: 1.5px;
    background: var(--crimson);
  }
  .case-list.is-outcome li::before {
    content: '✓';
    width: auto;
    height: auto;
    top: 0;
    background: none;
    color: #3ddc84;
    font-size: 13px;
  }
  .case-links {
    display: flex;
    flex-wrap: wrap;
    gap: 12px;
    margin-top: 36px;
  }
</style>
