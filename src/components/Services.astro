---
import { Image } from 'astro:assets';
import type { ImageMetadata } from 'astro';
import SectionHead from './SectionHead.astro';
import { content, pad, type Lang } from '../i18n';
import freelanceLogo from '../assets/logos/freelance.svg';

interface Props {
  lang: Lang;
}
const { lang } = Astro.props;
const t = content[lang];
const s = t.services;

// Optional thumbnails: src/assets/services/<id>.(png|jpg|jpeg|webp|svg)
const thumbs = import.meta.glob<{ default: ImageMetadata }>('../assets/services/*.{png,jpg,jpeg,webp,svg}', { eager: true });
const thumbFor = (id: string) =>
  Object.entries(thumbs).find(([path]) => path.split('/').pop()!.replace(/\.\w+$/, '') === id)?.[1].default;
---

<section id="services" class="section" data-section={t.ui.sections.services} data-index="08">
  <div class="container">
    <div class="head">
      <SectionHead index="08" kicker={s.kicker} title={s.title} lead={s.lead} />
      <button type="button" class="license-btn" data-reveal style="--i:2" aria-haspopup="dialog" aria-controls="licenses" data-licenses-open>
        <Image src={freelanceLogo} alt="العمل الحر" width={236} class="license-logo" />
        <span class="license-meta">
          <span class="license-badge mono"><i aria-hidden="true"></i>{s.licenses.badge}</span>
          <span class="license-view mono">{s.licenses.view} <b aria-hidden="true">↗</b></span>
        </span>
      </button>
    </div>

    <ul class="services">
      {
        s.items.map((item, i) => {
          const thumb = thumbFor(item.id);
          return (
            <li data-reveal style={`--i:${i}`}>
              <a class="service" href={item.href} target="_blank" rel="noopener">
                <div class="media">
                  {thumb ? (
                    <Image src={thumb} alt="" widths={[480, 720, 960]} sizes="(min-width: 960px) 400px, 92vw" />
                  ) : (
                    <div class="placeholder" aria-hidden="true">
                      <span class="ph-num">{pad(i + 1)}</span>
                    </div>
                  )}
                </div>
                <div class="body">
                  {thumb && <p class="mono num">{pad(i + 1)}</p>}
                  <h3 class="title">{item.title}</h3>
                  <p class="desc">{item.description}</p>
                  {item.tags.length > 0 && (
                    <ul class="tags">
                      {item.tags.map((tag) => (
                        <li class="chip">{tag}</li>
                      ))}
                    </ul>
                  )}
                  <span class="cta mono">
                    {s.cta} <i aria-hidden="true">↗</i>
                  </span>
                </div>
              </a>
            </li>
          );
        })
      }
    </ul>
  </div>
</section>

<dialog id="licenses" class="lic" aria-labelledby="licenses-title" data-licenses>
  <div class="lic-panel">
    <div class="lic-top">
      <Image src={freelanceLogo} alt="" width={160} class="lic-logo" />
      <button type="button" class="lic-close" data-licenses-close aria-label={s.licenses.close}>
        <svg viewBox="0 0 16 16" aria-hidden="true"><path d="M3.5 3.5l9 9m0-9-9 9" stroke="currentColor" stroke-width="1.6" stroke-linecap="round"></path></svg>
      </button>
    </div>
    <h3 id="licenses-title" class="lic-title">{s.licenses.title}</h3>
    <p class="lic-note">{s.licenses.note}</p>
    <ul class="lic-list">
      {
        s.licenses.items.map((l) => (
          <li>
            <a href={l.file} target="_blank" rel="noopener" class="lic-item">
              <span class="lic-icon" aria-hidden="true">PDF</span>
              <span class="lic-text">
                <span class="lic-name">{l.title}</span>
                <span class="lic-valid mono">{l.valid}</span>
              </span>
              <span class="lic-open mono">{s.licenses.open} ↗</span>
            </a>
          </li>
        ))
      }
    </ul>
  </div>
</dialog>

<script>
  const dlg = document.querySelector<HTMLDialogElement>('[data-licenses]')!;
  const openBtn = document.querySelector<HTMLButtonElement>('[data-licenses-open]')!;
  let timer: number | undefined;

  function open() {
    window.clearTimeout(timer);
    dlg.showModal();
    requestAnimationFrame(() => requestAnimationFrame(() => (dlg.dataset.state = 'open')));
  }
  function close() {
    if (!dlg.open || dlg.dataset.state === 'closing') return;
    dlg.dataset.state = 'closing';
    timer = window.setTimeout(() => {
      delete dlg.dataset.state;
      dlg.close();
      openBtn.focus({ preventScroll: true });
    }, 160);
  }

  openBtn.addEventListener('click', open);
  dlg.querySelector('[data-licenses-close]')!.addEventListener('click', close);
  dlg.addEventListener('cancel', (e) => {
    e.preventDefault();
    close();
  });
  dlg.addEventListener('click', (e) => {
    if (e.target === dlg) close(); // backdrop
  });
</script>

<style>
  /* ----- Header row: title + licence badge ----- */
  .head {
    display: grid;
    gap: 32px;
    align-items: end;
    margin-bottom: clamp(40px, 6vw, 72px);
  }
  .head :global(.section-head) {
    margin-bottom: 0;
  }
  @media (min-width: 960px) {
    .head {
      grid-template-columns: 1fr auto;
      align-items: center;
    }
  }

  .license-btn {
    justify-self: start;
    display: grid;
    gap: 16px;
    padding: 22px 26px;
    border-radius: var(--radius);
    background:
      radial-gradient(80% 100% at 100% 0%, rgb(73 168 187 / 0.16), transparent 70%),
      var(--surface-2);
    box-shadow: 0 0 0 1px var(--line-strong);
    text-align: start;
    transition:
      transform 160ms var(--ease-out),
      box-shadow 250ms ease;
  }
  @media (min-width: 960px) {
    .license-btn {
      justify-self: end;
    }
  }
  .license-btn:active {
    transform: scale(0.98);
  }
  @media (hover: hover) and (pointer: fine) {
    .license-btn:hover {
      box-shadow:
        0 0 0 1px rgb(73 168 187 / 0.55),
        0 20px 50px -24px rgb(73 168 187 / 0.5);
    }
    .license-btn:hover .license-view b {
      transform: translate(2px, -2px);
    }
  }
  .license-btn :global(.license-logo) {
    width: clamp(180px, 18vw, 236px);
    height: auto;
  }
  .license-meta {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    justify-content: space-between;
    gap: 8px 20px;
  }
  .license-badge {
    display: inline-flex;
    align-items: center;
    gap: 8px;
    color: #7fd0de;
  }
  .license-badge i {
    width: 7px;
    height: 7px;
    border-radius: 50%;
    background: #49a8bb;
  }
  .license-view {
    color: var(--text);
  }
  .license-view b {
    display: inline-block;
    font-weight: 400;
    color: var(--accent-bright);
    transition: transform 250ms var(--ease-out);
  }

  /* ----- Licences dialog ----- */
  .lic {
    width: min(560px, calc(100% - 32px));
    max-height: calc(100dvh - 32px);
    margin: auto;
    padding: 0;
    border: 0;
    border-radius: calc(var(--radius) + 4px);
    background: var(--surface-2);
    color: var(--text);
    box-shadow:
      0 0 0 1px var(--line-strong),
      0 40px 100px -20px rgb(0 0 0 / 0.8);
    opacity: 0;
    transform: scale(0.96);
    transition:
      opacity 150ms ease,
      transform 150ms ease;
  }
  .lic[data-state='open'] {
    opacity: 1;
    transform: none;
    transition:
      opacity 220ms var(--ease-out),
      transform 260ms var(--ease-out);
  }
  .lic::backdrop {
    background: rgb(3 3 3 / 0.7);
    backdrop-filter: blur(4px);
    -webkit-backdrop-filter: blur(4px);
  }
  @media (prefers-reduced-motion: reduce) {
    .lic,
    .lic[data-state='open'] {
      transform: none;
    }
  }
  .lic-panel {
    padding: clamp(22px, 4vw, 32px);
  }
  .lic-top {
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: 16px;
  }
  .lic-top :global(.lic-logo) {
    width: 140px;
    height: auto;
  }
  .lic-close {
    display: grid;
    place-items: center;
    width: 40px;
    height: 40px;
    border-radius: 50%;
    border: 1px solid var(--line-strong);
    transition: transform 160ms var(--ease-out);
  }
  .lic-close:active {
    transform: scale(0.94);
  }
  .lic-close svg {
    width: 16px;
    height: 16px;
  }
  .lic-title {
    margin: 24px 0 8px;
    font-size: 24px;
    font-weight: 600;
  }
  .lic-note {
    margin: 0 0 22px;
    color: var(--text-muted);
    font-size: 15px;
  }
  .lic-list {
    list-style: none;
    margin: 0;
    padding: 0;
    display: grid;
    gap: 10px;
  }
  .lic-item {
    display: flex;
    align-items: center;
    gap: 16px;
    padding: 16px 18px;
    border-radius: 12px;
    background: var(--surface);
    box-shadow: 0 0 0 1px var(--line);
    transition:
      transform 160ms var(--ease-out),
      box-shadow 200ms ease;
  }
  .lic-item:active {
    transform: scale(0.98);
  }
  @media (hover: hover) and (pointer: fine) {
    .lic-item:hover {
      box-shadow: 0 0 0 1px rgb(73 168 187 / 0.55);
    }
  }
  .lic-icon {
    flex: none;
    display: grid;
    place-items: center;
    width: 44px;
    height: 52px;
    border-radius: 8px;
    background: rgb(191 9 47 / 0.14);
    color: var(--accent-bright);
    font-family: var(--font-mono);
    font-size: 11px;
    font-weight: 700;
    letter-spacing: 0.06em;
  }
  .lic-text {
    display: grid;
    gap: 4px;
    min-width: 0;
  }
  .lic-name {
    font-weight: 600;
    line-height: 1.35;
  }
  .lic-valid {
    color: var(--text-muted);
  }
  .lic-open {
    margin-inline-start: auto;
    flex: none;
    color: var(--text);
  }
  @media (max-width: 480px) {
    .lic-open {
      display: none;
    }
  }

  .services {
    list-style: none;
    margin: 0;
    padding: 0;
    display: grid;
    gap: clamp(16px, 2vw, 24px);
  }
  @media (min-width: 960px) {
    .services {
      grid-template-columns: repeat(3, minmax(0, 1fr));
    }
  }
  .services > li {
    display: grid;
  }

  .service {
    display: grid;
    grid-template-rows: auto 1fr;
    border-radius: var(--radius);
    background: var(--surface);
    box-shadow: 0 0 0 1px var(--line);
    overflow: hidden;
    transition:
      box-shadow 250ms ease,
      transform 160ms var(--ease-out);
  }
  .service:active {
    transform: scale(0.99);
  }
  .service:focus-visible {
    outline-offset: 2px;
  }

  .media {
    aspect-ratio: 2560 / 1538; /* matches the service cover images */
    overflow: hidden;
    background: var(--surface-2);
    border-bottom: 1px solid var(--line);
  }
  .media :global(img) {
    width: 100%;
    height: 100%;
    object-fit: cover;
    transition: transform 600ms var(--ease-out);
  }

  /* Branded fallback tile when no thumbnail is provided */
  .placeholder {
    position: relative;
    height: 100%;
    display: grid;
    place-items: center;
    background:
      radial-gradient(70% 90% at 100% 0%, rgb(38 31 179 / 0.55), transparent 70%),
      radial-gradient(60% 80% at 0% 100%, rgb(191 9 47 / 0.25), transparent 70%),
      var(--surface-2);
  }
  .placeholder::before {
    content: '';
    position: absolute;
    inset: 0;
    background-image:
      linear-gradient(var(--line) 1px, transparent 1px),
      linear-gradient(90deg, var(--line) 1px, transparent 1px);
    background-size: 32px 32px;
    mask-image: radial-gradient(60% 60% at 50% 50%, #000, transparent 80%);
    -webkit-mask-image: radial-gradient(60% 60% at 50% 50%, #000, transparent 80%);
  }
  .ph-num {
    position: relative;
    font-family: var(--font-display);
    font-weight: 900;
    font-variation-settings: 'opsz' 144, 'SOFT' 100;
    font-size: clamp(72px, 9vw, 120px);
    line-height: 1;
    color: var(--text);
    opacity: 0.9;
  }

  .body {
    display: flex;
    flex-direction: column;
    gap: 12px;
    padding: clamp(20px, 2.4vw, 28px);
  }
  .num {
    margin: 0;
    color: var(--accent-bright);
  }
  .title {
    margin: 0;
    font-size: clamp(21px, 1.9vw, 25px);
    font-weight: 600;
    line-height: 1.2;
    letter-spacing: -0.01em;
    text-wrap: balance;
  }
  :global([lang='ar']) .title {
    letter-spacing: 0;
    line-height: 1.45;
  }
  .desc {
    margin: 0;
    color: var(--text-muted);
    text-wrap: pretty;
  }
  .tags {
    list-style: none;
    margin: 4px 0 0;
    padding: 0;
    display: flex;
    flex-wrap: wrap;
    gap: 6px;
  }
  .cta {
    margin-top: auto;
    padding-top: 8px;
    color: var(--text);
  }
  .cta i {
    display: inline-block;
    font-style: normal;
    color: var(--accent-bright);
    transition: transform 250ms var(--ease-out);
  }

  @media (hover: hover) and (pointer: fine) {
    .service:hover {
      box-shadow:
        0 0 0 1px var(--line-strong),
        0 24px 60px -30px rgb(38 31 179 / 0.7);
    }
    .service:hover .media :global(img) {
      transform: scale(1.03);
    }
    .service:hover .cta i {
      transform: translate(2px, -2px);
    }
  }
</style>
