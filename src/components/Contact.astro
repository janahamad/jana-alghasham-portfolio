---
import { Image } from 'astro:assets';
import { content, person, type Lang } from '../i18n';
import art from '../assets/illustrations/jana-illustration-development.svg';

interface Props {
  lang: Lang;
}
const { lang } = Astro.props;
const t = content[lang];
const c = t.ui.contact;
---

<section id="contact" class="section contact" data-section={t.ui.sections.contact} data-index="07">
  <div class="contact-bg" aria-hidden="true"></div>
  <div class="container contact-grid">
    <div>
      <p class="section-index mono" data-reveal><b>[07]</b> {c.kicker}</p>
      <h2 class="contact-title" data-reveal style="--i:1">
        <Fragment set:html={c.titleA} /><span>{c.titleEm}</span>{c.titleB}
      </h2>
      <p class="contact-lead" data-reveal style="--i:2">
        {c.lead}<strong>{c.leadStrong}</strong>{c.leadAfter}
      </p>

      <div class="contact-mail" data-reveal style="--i:3">
        <a href={`mailto:${person.email}`} class="mail-link" dir="ltr">{person.email}</a>
        <button type="button" class="copy mono" data-copy={person.email} data-copied={c.copied} data-fail={c.copyFail}>
          <span data-copy-label>{c.copy}</span>
        </button>
      </div>

      <ul class="contact-links" data-reveal style="--i:4">
        <li><a class="btn btn-primary" href={person.social.linkedin} target="_blank" rel="noopener">LinkedIn ↗</a></li>
        <li><a class="btn btn-ghost" href={person.social.github} target="_blank" rel="noopener">GitHub ↗</a></li>
        <li><a class="btn btn-ghost" href={person.cv} download>{t.ui.downloadCv} ↓</a></li>
      </ul>
    </div>

    <Image src={art} alt="" width={720} class="contact-art" data-reveal style="--i:2" />
  </div>

  <footer class="footer container">
    <img src="/brand/jana-icon.svg" alt="" width="28" height="28" />
    <p class="mono" dir="ltr">© {new Date().getFullYear()} {person.fullNameEn}</p>
    <p class="footer-ar" lang="ar" dir="rtl">{person.nameAr}</p>
    <a href="#top" class="mono footer-top">{t.ui.backToTop}</a>
  </footer>
</section>

<script>
  const btn = document.querySelector<HTMLButtonElement>('[data-copy]');
  const label = btn?.querySelector('[data-copy-label]');
  const original = label?.textContent;
  let timer: number | undefined;
  btn?.addEventListener('click', async () => {
    try {
      await navigator.clipboard.writeText(btn.dataset.copy!);
      label!.textContent = btn.dataset.copied!;
    } catch {
      label!.textContent = btn.dataset.fail!;
    }
    btn.classList.add('is-done');
    window.clearTimeout(timer);
    timer = window.setTimeout(() => {
      label!.textContent = original!;
      btn.classList.remove('is-done');
    }, 1800);
  });
</script>

<style>
  .contact {
    overflow: hidden;
    isolation: isolate;
    padding-bottom: 0;
  }
  .contact-bg {
    position: absolute;
    inset: 0;
    z-index: -1;
    background:
      radial-gradient(55% 60% at 50% 110%, rgb(38 31 179 / 0.5), transparent 70%),
      radial-gradient(35% 35% at 85% 95%, rgb(191 9 47 / 0.22), transparent 70%);
  }

  .contact-grid {
    display: grid;
    gap: 48px;
    align-items: center;
  }
  @media (min-width: 1040px) {
    .contact-grid {
      grid-template-columns: 1.4fr 1fr;
    }
  }
  :global(.contact-art) {
    width: 100%;
    max-width: 520px;
    height: auto;
    justify-self: center;
    border-radius: var(--radius);
  }
  @media (max-width: 1039px) {
    :global(.contact-art) {
      display: none;
    }
  }

  .contact-title {
    margin: 24px 0 0;
    font-family: var(--font-display);
    font-weight: 900;
    font-variation-settings: 'opsz' 144, 'SOFT' 100;
    font-size: clamp(44px, 7.4vw, 112px);
    line-height: 0.95;
    letter-spacing: -0.03em;
    text-wrap: balance;
  }
  :global([lang='ar']) .contact-title {
    font-weight: 700;
    letter-spacing: 0;
    line-height: 1.3;
  }
  .contact-title span {
    color: var(--crimson);
  }
  .contact-lead {
    margin: 28px 0 0;
    max-width: 52ch;
    font-size: clamp(18px, 1.7vw, 21px);
    color: var(--text-muted);
  }
  .contact-lead strong {
    color: #7cf0b0;
    font-weight: 600;
  }

  .contact-mail {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    gap: 12px 20px;
    margin-top: clamp(36px, 5vw, 56px);
  }
  .mail-link {
    font-size: clamp(22px, 3.2vw, 40px);
    font-weight: 500;
    letter-spacing: -0.02em;
    text-decoration: underline;
    text-decoration-color: var(--crimson);
    text-decoration-thickness: 2px;
    text-underline-offset: 0.2em;
    overflow-wrap: anywhere;
  }
  .copy {
    height: 36px;
    padding: 0 14px;
    border-radius: 999px;
    border: 1px solid var(--line-strong);
    color: var(--text-muted);
    transition:
      transform 160ms var(--ease-out),
      color 200ms ease,
      border-color 200ms ease;
  }
  .copy:active {
    transform: scale(0.96);
  }
  .copy.is-done {
    color: #3ddc84;
    border-color: rgb(61 220 132 / 0.4);
  }

  .contact-links {
    list-style: none;
    margin: 32px 0 0;
    padding: 0;
    display: flex;
    flex-wrap: wrap;
    gap: 12px;
  }

  .footer {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    gap: 12px 24px;
    margin-top: clamp(96px, 14vw, 180px);
    padding-block: 28px calc(28px + env(safe-area-inset-bottom));
    border-top: 1px solid var(--line);
    color: var(--text-faint);
  }
  .footer img {
    border-radius: 7px;
  }
  .footer p {
    margin: 0;
  }
  .footer-ar {
    font-family: var(--font-ar);
    font-size: 14px;
  }
  .footer-top {
    margin-inline-start: auto;
    color: var(--text-muted);
  }
</style>
