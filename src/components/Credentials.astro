---
import { Image } from 'astro:assets';
import SectionHead from './SectionHead.astro';
import { content, type Lang } from '../i18n';
import aws from '../assets/badges/aws-cloud-practitioner.png';
import oci from '../assets/badges/oracle-oci-foundations.png';
import qassim from '../assets/logos/qassim-university.webp';
import sda from '../assets/logos/saudi-digital-academy.png';

interface Props {
  lang: Lang;
}
const { lang } = Astro.props;
const t = content[lang];
const head = t.ui.heads.credentials;
const badges = { aws, oci } as const;
const eduLogos = { qassim, sda } as const;
---

<section id="credentials" class="section" data-section={t.ui.sections.credentials} data-index="07">
  <div class="container">
    <SectionHead index="07" kicker={head.kicker} title={head.title} />

    <h3 class="mono col-title">{t.ui.credentials.certs}</h3>
    <ul class="certs">
      {
        t.certifications.map((c, i) => (
          <li class="cert" data-reveal style={`--i:${i}`}>
            <div class="cert-badge">
              {c.badge ? (
                <Image src={badges[c.badge]} alt="" height={300} />
              ) : (
                <svg class="cert-icon" viewBox="0 0 64 72" fill="none" aria-hidden="true">
                  <path d="M32 4 58 14v20c0 17-11 28-26 34C17 62 6 51 6 34V14L32 4Z" stroke="currentColor" stroke-width="2.5" stroke-linejoin="round" />
                  <path d="m21 37 8 8 15-17" stroke="var(--accent-bright)" stroke-width="3" stroke-linecap="round" stroke-linejoin="round" />
                </svg>
              )}
            </div>
            <div class="cert-text" dir="ltr">
              <p class="cert-title">{c.title}</p>
              <p class="mono cert-meta">
                {c.issuer} · {c.year}
              </p>
            </div>
          </li>
        ))
      }
    </ul>

    <h3 class="mono col-title edu-title-h">{t.ui.credentials.education}</h3>
    <ul class="edu">
      {
        t.education.map((e, i) => (
          <li data-reveal style={`--i:${i}`}>
            <p class="mono edu-period">{e.period}</p>
            <div>
              <Image src={eduLogos[e.logo]} alt={e.org} height={88} class="edu-logo" />
              <p class="edu-title">{e.title}</p>
              <p class="edu-org">{e.org}</p>
              {e.note && <p class="edu-note">{e.note}</p>}
            </div>
          </li>
        ))
      }
    </ul>
  </div>
</section>

<style>
  .col-title {
    margin: 0 0 20px;
    color: var(--text-faint);
    font-weight: 400;
  }
  .edu-title-h {
    margin-top: clamp(56px, 8vw, 96px);
  }

  /* ----- Certifications: badge-first cards ----- */
  .certs {
    list-style: none;
    margin: 0;
    padding: 0;
    display: grid;
    gap: clamp(16px, 2vw, 24px);
  }
  @media (min-width: 760px) {
    .certs {
      grid-template-columns: repeat(3, minmax(0, 1fr));
    }
  }
  .cert {
    display: grid;
    justify-items: center;
    align-content: start;
    gap: 20px;
    padding: clamp(24px, 3vw, 36px) 20px;
    border-radius: var(--radius);
    background: radial-gradient(80% 60% at 50% 0%, rgb(38 31 179 / 0.22), transparent 70%), var(--surface-2);
    box-shadow: 0 0 0 1px var(--line);
    text-align: center;
  }
  .cert-badge {
    --badge-h: clamp(128px, 14vw, 156px);
    display: grid;
    place-items: center;
    height: var(--badge-h);
  }
  .cert-badge :global(img) {
    width: auto;
    height: var(--badge-h);
    max-width: 100%;
    object-fit: contain;
    filter: drop-shadow(0 12px 24px rgb(0 0 0 / 0.5));
  }
  .cert-icon {
    height: calc(var(--badge-h) * 0.72);
    width: auto;
    color: var(--text-muted);
  }
  .cert-text {
    text-align: center;
  }
  .cert-title {
    margin: 0;
    font-size: 18px;
    font-weight: 600;
    line-height: 1.3;
    text-wrap: balance;
  }
  .cert-meta {
    margin: 8px 0 0;
    color: var(--text-muted);
  }

  /* ----- Education ----- */
  .edu {
    list-style: none;
    margin: 0;
    padding: 0;
    border-top: 1px solid var(--line);
  }
  .edu li {
    display: grid;
    gap: 8px;
    padding: 24px 0;
    border-bottom: 1px solid var(--line);
  }
  @media (min-width: 900px) {
    .edu li {
      grid-template-columns: 260px 1fr;
      gap: 48px;
    }
  }
  .edu p {
    margin: 0;
  }
  .edu-period {
    color: var(--accent-bright);
    padding-top: 4px;
  }
  /* Wide wordmarks with dark ink: shown on a light tile, like the Experience logos */
  :global(.edu-logo) {
    display: block;
    width: auto;
    height: 44px;
    max-width: 100%;
    object-fit: contain;
    margin-bottom: 14px;
    padding: 6px 12px;
    border-radius: 10px;
    background: #fff;
  }
  .edu-title {
    font-size: 21px;
    font-weight: 600;
    line-height: 1.3;
  }
  .edu-org {
    color: var(--text-muted);
  }
  .edu-note {
    margin-top: 10px !important;
    color: var(--text-faint);
    font-size: 15px;
  }
</style>
